{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "@lib/*": ["./lib/*"],
      "@/*": ["./src/*"]
    },
    "strictNullChecks": true,
    "allowJs": true
  }
}
