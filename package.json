    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.46.1",
    "mathjs": "^15.2.0",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "sass-embedded": "^1.100.0"
  }
}
